FROM ros:humble

ENV DEBIAN_FRONTEND=noninteractive

# 기본 개발 도구
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-colcon-common-extensions \
    python3-vcstool \
    python3-rosdep \
    ros-humble-xacro \
    git \
    wget \
    curl \
    vim \
    nano \
    build-essential \
    cmake \
    mesa-utils \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    libglfw3 \
    libglfw3-dev \
    libosmesa6 \
    libosmesa6-dev \
    libglew-dev \
    libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*

# Python 패키지
RUN pip3 install --no-cache-dir \
    mujoco==3.1.6 \
    urdf2mjcf \
    numpy \
    scipy \
    glfw \
    imageio \
    opencv-python

# ROS 초기화
RUN rosdep init || true

WORKDIR /ros_ws

COPY docker/entrypoint.sh /
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]

CMD ["tail","-f","/dev/null"]