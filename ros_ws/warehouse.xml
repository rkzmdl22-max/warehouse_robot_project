<mujoco model="warehouse_realistic_scene">
  <!--
    Main Integrated Realistic Warehouse Scene
    Coordinates & Bounds SSOT: config/warehouse_layout.yaml
    Layout: docs/REORGANIZATION_PLAN.md & docs/GAZEBO_TO_MUJOCO.md
  -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" iterations="50"/>

  <default>
    <joint limited="true" damping="0.01" armature="0.01" frictionloss="0.01"/>
    <geom condim="4" contype="1" conaffinity="15"/>
  </default>

  <asset>
    <!-- Epoxy Industrial Floor Checkerboard Texture & Materials -->
    <texture name="texfloor" type="2d" builtin="checker" rgb1="0.15 0.18 0.22" rgb2="0.25 0.28 0.32" width="512" height="512"/>
    <material name="matfloor" texture="texfloor" texrepeat="20 20" reflectance="0.1" specular="0.2" shininess="0.3"/>
    <material name="matwall" rgba="0.85 0.88 0.92 1" specular="0.1" shininess="0.1"/>

    <!-- Shelf Materials -->
    <material name="shelf_frame_mat" rgba="0.15 0.2 0.25 1" specular="0.4" shininess="0.5"/>
    <material name="shelf_plate_mat" rgba="0.4 0.42 0.45 1" specular="0.3" shininess="0.3"/>

    <!-- Pallet Materials -->
    <material name="wood_pallet_mat" rgba="0.65 0.45 0.25 1" specular="0.1" shininess="0.1"/>
    <material name="pallet_runner_mat" rgba="0.5 0.35 0.2 1" specular="0.1" shininess="0.1"/>

    <!-- Cardboard Box Materials -->
    <material name="box_cardboard1_mat" rgba="0.78 0.58 0.35 1" specular="0.2" shininess="0.2"/>
    <material name="box_cardboard2_mat" rgba="0.3 0.55 0.85 1" specular="0.3" shininess="0.4"/>
    <material name="box_small_mat" rgba="0.85 0.7 0.3 1" specular="0.2" shininess="0.2"/>

    <!-- Logistics Zone Materials -->
    <material name="loading_zone_mat" rgba="0.1 0.8 0.2 0.35"/>
    <material name="shipping_zone_mat" rgba="0.9 0.2 0.1 0.35"/>
    <material name="hazard_stripe_mat" rgba="0.9 0.8 0.1 0.6"/>
    <material name="dock_mat" rgba="0.3 0.3 0.35 1"/>
  </asset>

  <worldbody>
    <!-- Multi-directional Overhead Factory Lighting -->
    <light name="light_overhead_center" pos="0 0 7.5" dir="0 0 -1" diffuse="0.8 0.8 0.85" specular="0.3 0.3 0.3" castshadow="true"/>
    <light name="light_overhead_nw" pos="-6 5 6.0" dir="0 0 -1" diffuse="0.5 0.5 0.55" specular="0.1 0.1 0.1"/>
    <light name="light_overhead_se" pos="6 -5 6.0" dir="0 0 -1" diffuse="0.5 0.5 0.55" specular="0.1 0.1 0.1"/>
    <light name="light_spot_picking" pos="-4 -2 4.0" dir="0 0 -1" diffuse="0.6 0.6 0.7" specular="0.4 0.4 0.4"/>

    <!-- Ground Floor (20m x 20m Arena, Center Z=0) -->
    <geom name="floor" type="plane" pos="0 0 0" size="10 10 0.1" material="matfloor" contype="1" conaffinity="1" friction="0.8 0.1 0.1"/>

    <!-- Perimeter Walls (Size half-extents for 20m length, 2.5m height, 0.2m thickness) -->
    <geom name="wall_left" type="box" pos="0.0 -10.0 1.25" size="10.0 0.1 1.25" material="matwall" contype="1" conaffinity="1"/>
    <geom name="wall_right" type="box" pos="0.0 10.0 1.25" size="10.0 0.1 1.25" material="matwall" contype="1" conaffinity="1"/>
    <geom name="wall_front" type="box" pos="10.0 0.0 1.25" size="0.1 10.0 1.25" material="matwall" contype="1" conaffinity="1"/>
    <geom name="wall_back" type="box" pos="-10.0 0.0 1.25" size="0.1 10.0 1.25" material="matwall" contype="1" conaffinity="1"/>
  </worldbody>

  <!-- Include Modular Warehouse Components at Root Level -->
  <include file="../warehouse/shelves.xml"/>
  <include file="../warehouse/pallets.xml"/>
  <include file="../warehouse/boxes.xml"/>
  <include file="../warehouse/zones.xml"/>
  <include file="../warehouse/conveyor.xml"/>
  <include file="../warehouse/tron1_station.xml"/>
</mujoco>

