#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "ur"
    doc = """Generated from Composed Stage of root layer /tmp/tmpqltbz62i/ur.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_ur_dlnxmg5e/usdex_ur/ur.usdc


