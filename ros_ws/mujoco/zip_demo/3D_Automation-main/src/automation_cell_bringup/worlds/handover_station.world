<?xml version="1.0"?>
<sdf version="1.6">
  <world name="handover_station">

    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="station_table">
      <static>true</static>
      <pose>1.2 0 0 0 0 0</pose>

      <link name="table_link">
        <collision name="top_collision">
          <pose>0 0 0.24 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 0.6 0.05</size>
            </box>
          </geometry>
        </collision>

        <visual name="top_visual">
          <pose>0 0 0.24 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 0.6 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.35 0.55 1</ambient>
            <diffuse>0.25 0.35 0.55 1</diffuse>
          </material>
        </visual>

        <collision name="leg_1_collision">
          <pose>0.32 0.22 0.1075 0 0 0</pose>
          <geometry>
            <box>
              <size>0.06 0.06 0.215</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg_1_visual">
          <pose>0.32 0.22 0.1075 0 0 0</pose>
          <geometry>
            <box>
              <size>0.06 0.06 0.215</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>

        <collision name="leg_2_collision">
          <pose>0.32 -0.22 0.1075 0 0 0</pose>
          <geometry>
            <box>
              <size>0.06 0.06 0.215</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg_2_visual">
          <pose>0.32 -0.22 0.1075 0 0 0</pose>
          <geometry>
            <box>
              <size>0.06 0.06 0.215</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>

        <collision name="leg_3_collision">
          <pose>-0.32 0.22 0.1075 0 0 0</pose>
          <geometry>
            <box>
              <size>0.06 0.06 0.215</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg_3_visual">
          <pose>-0.32 0.22 0.1075 0 0 0</pose>
          <geometry>
            <box>
              <size>0.06 0.06 0.215</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>

        <collision name="leg_4_collision">
          <pose>-0.32 -0.22 0.1075 0 0 0</pose>
          <geometry>
            <box>
              <size>0.06 0.06 0.215</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg_4_visual">
          <pose>-0.32 -0.22 0.1075 0 0 0</pose>
          <geometry>
            <box>
              <size>0.06 0.06 0.215</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="water_bottle">
      <pose>0.9 0 0.365 0 0 0</pose>

      <link name="bottle_link">
        <inertial>
          <mass>0.3</mass>
          <inertia>
            <ixx>0.002342</ixx>
            <iyy>0.002342</iyy>
            <izz>0.000184</izz>
          </inertia>
        </inertial>

        <collision name="bottle_collision">
          <geometry>
            <cylinder>
              <radius>0.035</radius>
              <length>0.20</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="bottle_visual">
          <geometry>
            <cylinder>
              <radius>0.035</radius>
              <length>0.20</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.55 0.9 0.8</ambient>
            <diffuse>0.1 0.55 0.9 0.8</diffuse>
          </material>
        </visual>

        <visual name="cap_visual">
          <pose>0 0 0.1075 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.022</radius>
              <length>0.015</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.2 0.8 1</ambient>
            <diffuse>0.1 0.2 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="station_rgbd_camera">
      <static>true</static>

      <!-- 테이블 측면 위쪽에서 물병을 내려다보는 위치 -->
      <pose>1.1 -0.75 0.75 0 0.48 1.5708</pose>

      <link name="camera_link">
        <visual name="camera_body_visual">
          <geometry>
            <box>
              <size>0.12 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>

        <sensor name="rgbd_sensor" type="depth">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>false</visualize>

          <camera>
            <horizontal_fov>1.0471976</horizontal_fov>

            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>

            <clip>
              <near>0.10</near>
              <far>5.0</far>
            </clip>

            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.002</stddev>
            </noise>
          </camera>

          <plugin
            name="station_rgbd_camera_plugin"
            filename="libgazebo_ros_camera.so">

            <ros>
              <namespace>/station_camera</namespace>
              <remapping>image_raw:=color/image_raw</remapping>
              <remapping>camera_info:=color/camera_info</remapping>
            </ros>

            <camera_name>station_rgbd</camera_name>
            <frame_name>station_camera_optical_frame</frame_name>
            <hack_baseline>0.0</hack_baseline>
            <min_depth>0.10</min_depth>
            <max_depth>5.0</max_depth>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>