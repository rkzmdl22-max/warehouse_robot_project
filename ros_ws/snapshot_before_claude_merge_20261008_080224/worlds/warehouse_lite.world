<?xml version="1.0"?>
<sdf version="1.7">
  <world name="warehouse_lite">

    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Left Wall -->
    <model name="wall_left">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>20 0.2 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>20 0.2 2.5</size>
            </box>
          </geometry>
        </visual>

        <pose>
          0 -10 1.25 0 0 0
        </pose>

      </link>

    </model>

    <!-- Right Wall -->
    <model name="wall_right">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>20 0.2 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>20 0.2 2.5</size>
            </box>
          </geometry>
        </visual>

        <pose>
          0 10 1.25 0 0 0
        </pose>

      </link>

    </model>

    <!-- Front Wall -->
    <model name="wall_front">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 20 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 20 2.5</size>
            </box>
          </geometry>
        </visual>

        <pose>
          10 0 1.25 0 0 0
        </pose>

      </link>

    </model>

    <!-- Back Wall -->
    <model name="wall_back">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 20 2.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 20 2.5</size>
            </box>
          </geometry>
        </visual>

        <pose>
          -10 0 1.25 0 0 0
        </pose>

      </link>

    </model>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>10 -10 8 0 0.5 2.3</pose>
      </camera>
    </gui>

    <!-- ========================= -->
    <!-- Shelf 1  (-6, -5) -->
    <!-- ========================= -->
    <model name="shelf_1">
      <static>true</static>
      <pose>-6 -5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>3 0.8 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>3 0.8 2</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- ========================= -->
