<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tiago_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Classic simulation package for TIAGo robot in a warehouse environment.</description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ================================================================
       Runtime dependencies
  ================================================================ -->

  <!-- Robot description & state publishing -->
  <exec_depend>tiago_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- Gazebo Classic (ROS 2 bindings) -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros_pkgs</exec_depend>

  <!-- TIAGo bringup: controllers + play_motion2 + twist_mux -->
  <exec_depend>tiago_bringup</exec_depend>
  <exec_depend>tiago_controller_configuration</exec_depend>

  <!-- PAL launch helpers used in the launch files -->
  <exec_depend>launch_pal</exec_depend>

  <!-- ROS 2 launch infrastructure -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- ================================================================
       Test dependencies
  ================================================================ -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
