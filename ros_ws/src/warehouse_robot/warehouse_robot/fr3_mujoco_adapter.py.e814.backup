#!/usr/bin/env python3

import threading

import mujoco
import rclpy
from rclpy.node import Node

from trajectory_msgs.msg import JointTrajectory
from sensor_msgs.msg import JointState
from control_msgs.action import FollowJointTrajectory
from rclpy.action import ActionServer


class FR3MuJoCoAdapter(Node):

    ARM_JOINTS = [
        "fr3_joint1",
        "fr3_joint2",
        "fr3_joint3",
        "fr3_joint4",
        "fr3_joint5",
        "fr3_joint6",
        "fr3_joint7",
    ]

    FINGER_JOINTS = [
        "fr3_finger_joint1",
        "fr3_finger_joint2",
    ]

    ALL_JOINTS = ARM_JOINTS + FINGER_JOINTS

    ACTUATORS = [
        "fr3_joint1_motor",
        "fr3_joint2_motor",
        "fr3_joint3_motor",
        "fr3_joint4_motor",
        "fr3_joint5_motor",
        "fr3_joint6_motor",
        "fr3_joint7_motor",
        "fr3_gripper",
    ]

    def __init__(self):
        super().__init__("fr3_mujoco_adapter")

        self.declare_parameter(
            "model_path",
            "/ros_ws/mjcf_convert/fr3/output/fr3.xml",
        )

        model_path = self.get_parameter(
            "model_path"
        ).value

        self.get_logger().info(
            f"Loading MuJoCo model: {model_path}"
        )

        self.model = mujoco.MjModel.from_xml_path(model_path)
        self.data = mujoco.MjData(self.model)

        self.joint_qpos_adr = {}
        self.joint_dof_adr = {}
        self.actuator_id = {}

        for joint_name in self.ALL_JOINTS:
            joint_id = mujoco.mj_name2id(
                self.model,
                mujoco.mjtObj.mjOBJ_JOINT,
                joint_name,
            )

            if joint_id < 0:
                raise RuntimeError(
                    f"Joint not found: {joint_name}"
                )

            self.joint_qpos_adr[joint_name] = (
                self.model.jnt_qposadr[joint_id]
            )

            self.joint_dof_adr[joint_name] = (
                self.model.jnt_dofadr[joint_id]
            )

        for actuator_name in self.ACTUATORS:
            actuator_id = mujoco.mj_name2id(
                self.model,
                mujoco.mjtObj.mjOBJ_ACTUATOR,
                actuator_name,
            )

            if actuator_id < 0:
                raise RuntimeError(
                    f"Actuator not found: {actuator_name}"
                )

            self.actuator_id[actuator_name] = actuator_id

        self.get_logger().info(
            f"Model dimensions: "
            f"nq={self.model.nq}, "
            f"nv={self.model.nv}, "
            f"nu={self.model.nu}"
        )

        self.get_logger().info("FR3 joint map verified")
        self.get_logger().info("FR3 actuator map verified")

        self.target_q = self.data.qpos.copy()

        self.lock = threading.Lock()

        self.command_sub = self.create_subscription(
            JointTrajectory,
            "/fr3/command/joint_trajectory",
            self.trajectory_callback,
            10,
        )

        self.action_server = ActionServer(
            self,
            FollowJointTrajectory,
            "/fr3_arm_controller/follow_joint_trajectory",
            self.execute_trajectory,
        )

        self.state_pub = self.create_publisher(
            JointState,
            "/fr3/joint_states",
            10,
        )

        self.control_timer = self.create_timer(
            0.002,
            self.control_loop,
        )

        self.publish_timer = self.create_timer(
            0.01,
            self.publish_joint_state,
        )

    def trajectory_callback(self, msg):
        if not msg.joint_names:
            self.get_logger().warning(
                "Trajectory has no joint names"
            )
            return

        if not msg.points:
            self.get_logger().warning(
                "Trajectory has no points"
            )
            return

        point = msg.points[-1]

        if len(point.positions) != len(msg.joint_names):
            self.get_logger().warning(
                "Joint name / position size mismatch"
            )
            return

        with self.lock:
            for name, position in zip(
                msg.joint_names,
                point.positions,
            ):
                if name not in self.joint_qpos_adr:
                    self.get_logger().warning(
                        f"Unknown joint ignored: {name}"
                    )
                    continue

                self.target_q[
                    self.joint_qpos_adr[name]
                ] = position

        self.get_logger().info(
            "JointTrajectory command received"
        )

    async def execute_trajectory(self, goal_handle):
        trajectory = goal_handle.request.trajectory

        if not trajectory.joint_names:
            goal_handle.abort()
            return FollowJointTrajectory.Result()

        if not trajectory.points:
            goal_handle.abort()
            return FollowJointTrajectory.Result()

        point = trajectory.points[-1]

        if len(point.positions) != len(trajectory.joint_names):
            goal_handle.abort()
            return FollowJointTrajectory.Result()

        with self.lock:
            for name, position in zip(
                trajectory.joint_names,
                point.positions,
            ):
                if name not in self.joint_qpos_adr:
                    self.get_logger().warning(
                        f"Unknown action joint ignored: {name}"
                    )
                    continue

                self.target_q[
                    self.joint_qpos_adr[name]
                ] = position

        self.get_logger().info(
            "FollowJointTrajectory goal accepted"
        )

        goal_handle.succeed()

        result = FollowJointTrajectory.Result()
        result.error_code = FollowJointTrajectory.Result.SUCCESSFUL

        return result

    def control_loop(self):
        with self.lock:
            target = self.target_q.copy()

        kp = [
            80.0,
            80.0,
            80.0,
            80.0,
            30.0,
            20.0,
            10.0,
            5.0,
        ]

        kd = [
            8.0,
            8.0,
            8.0,
            8.0,
            3.0,
            2.0,
            1.0,
            0.5,
        ]

        for i, actuator_name in enumerate(
            self.ACTUATORS
        ):
            joint_name = self.ALL_JOINTS[i]

            qpos_adr = self.joint_qpos_adr[joint_name]
            dof_adr = self.joint_dof_adr[joint_name]
            actuator_id = self.actuator_id[actuator_name]

            q = self.data.qpos[qpos_adr]
            qd = self.data.qvel[dof_adr]

            torque = (
                kp[i] * (target[qpos_adr] - q)
                - kd[i] * qd
            )

            ctrl_min = self.model.actuator_ctrlrange[
                actuator_id, 0
            ]

            ctrl_max = self.model.actuator_ctrlrange[
                actuator_id, 1
            ]

            torque = max(
                ctrl_min,
                min(ctrl_max, torque),
            )

            self.data.ctrl[actuator_id] = torque

        mujoco.mj_step(
            self.model,
            self.data,
        )

    def publish_joint_state(self):
        msg = JointState()

        msg.header.stamp = (
            self.get_clock().now().to_msg()
        )

        msg.name = list(self.ALL_JOINTS)

        msg.position = [
            float(
                self.data.qpos[
                    self.joint_qpos_adr[name]
                ]
            )
            for name in self.ALL_JOINTS
        ]

        msg.velocity = [
            float(
                self.data.qvel[
                    self.joint_dof_adr[name]
                ]
            )
            for name in self.ALL_JOINTS
        ]

        msg.effort = [
            float(
                self.data.qfrc_actuator[
                    self.joint_dof_adr[name]
                ]
            )
            for name in self.ALL_JOINTS
        ]

        self.state_pub.publish(msg)


def main(args=None):
    rclpy.init(args=args)

    node = FR3MuJoCoAdapter()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
