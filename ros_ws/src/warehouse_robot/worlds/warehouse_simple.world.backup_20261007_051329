<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="warehouse_simple">

    <include>
      <uri>model://sun</uri>
    </include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <model name="warehouse_floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>16 12 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>16 12 0.1</size>
            </box>
          </geometry>
        </visual>
      </link>
      <pose>0 0 -0.05 0 0 0</pose>
    </model>

  </world>
</sdf>
